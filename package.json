{
  "name": "catodo",
  "version": "2.2.0",
  "description": "Tesla-first world TV explorer for user-approved public IPTV sources — zero bundled streams, zero DRM bypass, zero pezzotto.",
  "keywords": [
    "iptv",
    "hls",
    "tesla",
    "web-player",
    "internet-tv",
    "xmltv",
    "epg",
    "multiview",
    "pwa",
    "vanilla-javascript",
    "open-source",
    "agpl"
  ],
  "private": false,
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/enuzzo/catodo.git"
  },
  "bugs": {
    "url": "https://github.com/enuzzo/catodo/issues"
  },
  "homepage": "https://catodo.netmilk.dev/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "deploy:siteground": "node scripts/siteground-deploy.mjs",
    "preview": "vite preview",
    "test": "node --test tests/**/*.test.js",
    "check": "node scripts/check-syntax.mjs && node scripts/check-release.mjs",
    "release": "node scripts/release.mjs",
    "gen:htpasswd": "node gen-htpasswd.mjs"
  },
  "devDependencies": {
    "basic-ftp": "^6.2.0",
    "bcryptjs": "^3.0.3",
    "vite": "7.3.6"
  },
  "dependencies": {
    "@fontsource-variable/exo-2": "5.3.0",
    "@fontsource/ibm-plex-mono": "5.3.0",
    "@phosphor-icons/web": "2.1.2",
    "@svg-maps/world": "2.0.0",
    "fake-indexeddb": "^6.2.5",
    "flag-icons": "^7.5.0",
    "hls.js": "1.5.17"
  }
}
